{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "sortImports": {
    "groups": [
      "type",
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "side_effect",
      "unknown"
    ]
  },
  "proseWrap": "always",
  "ignorePatterns": ["bun.lock", "dist", "node_modules"]
}
